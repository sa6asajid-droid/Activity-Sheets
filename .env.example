# Curiosity Studio — server environment. Copy to .env.local and fill in.
# Nothing here is exposed to the browser.

# --- AI provider -------------------------------------------------------------
# Leave unset to run in demo mode (samples only, no generation).
ANTHROPIC_API_KEY=
# anthropic | mock | none   (default: anthropic when a key is set, otherwise none)
# "mock" produces labelled placeholder text for tests only.
# CS_TEXT_PROVIDER=anthropic
# anthropic-web-search | mock | none   (default: anthropic-web-search with the anthropic provider)
# CS_SEARCH_PROVIDER=anthropic-web-search

# Model for all stages, and optional per-stage overrides / effort levels.
# CS_MODEL=claude-opus-5-5
# CS_MODEL_CHECK=claude-sonnet-5-5
# CS_EFFORT_WRITE=medium        # low | medium | high | xhigh | max
# CS_REFUSAL_FALLBACKS=on       # server-side fallback model on refusals; "off" to disable

# --- Cost control ------------------------------------------------------------
# CS_DEFAULT_BUDGET_USD=2       # default per-worksheet limit (editable per project)
# CS_MAX_SEARCHES=6             # web searches per research stage
# CS_SEARCH_COST_USD=0.01       # used for estimates only; check current pricing
# CS_PRICE_CLAUDE_OPUS_5_5=4,20 # USD per million input,output tokens (estimates)
# CS_MAX_ATTEMPTS=2             # bounded retries per stage
# CS_REQUEST_TIMEOUT_MS=600000

# --- Storage -----------------------------------------------------------------
# CS_DATA_DIR=./data            # SQLite database, uploaded sources, exports
# CS_UPLOAD_MAX_BYTES=2097152

# --- Misc --------------------------------------------------------------------
# CS_PRODUCT_NAME=Curiosity Studio
# CS_NO_SAMPLES=1               # do not seed demo samples
# CS_CHROMIUM_PATH=             # custom Chromium for layout/PDF (defaults to Playwright's)
# CS_DISABLE_BROWSER_LAYOUT=1   # fall back to estimated pagination
